# URL del Frontend (CORS y redirecciones)
FRONTEND_URL=http://localhost:3000

# URL de conexión a la Base de Datos (PostgreSQL)
# Para Docker (por defecto en docker-compose.dev.yml): postgresql://postgres:examplePassword@postgres:5432/postgres
# Para ejecución local nativa: postgresql://postgres:examplePassword@localhost:5432/postgres
DATABASE_URL=postgresql://postgres:examplePassword@postgres:5432/postgres

# Secreto para Better Auth (Generar con: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret-key-change-it

# URL del backend/API para Better Auth
BETTER_AUTH_URL=http://localhost:3010

# API Key de Resend para envío de correos
RESEND_API_KEY=re_your_api_key

# URL de conexión a Redis
# Para Docker (por defecto en docker-compose.dev.yml): redis://redis:6379
# Para ejecución local nativa: redis://localhost:6379
REDIS_URL=redis://redis:6379
